# 数据源：tian-gong 生产库（只读）
SOURCE_HOST=127.0.0.1
SOURCE_PORT=3306
SOURCE_USER=readonly_user
SOURCE_PASSWORD=your_password
SOURCE_DATABASE=tian-gong

# 监控库：tg_monitor（读写）
MONITOR_HOST=127.0.0.1
MONITOR_PORT=3306
MONITOR_USER=monitor_user
MONITOR_PASSWORD=your_password
MONITOR_DATABASE=tg_monitor

# ES 日志监控
ES_URL=http://8.212.158.149:9200
ES_INDEX_PREFIX=q6

# LLM（兼容 OpenAI 接口，如 qwen3-max、deepseek 等）
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max

# Telegram 告警通知（可选，不配置则告警只写本地日志）
TG_BOT_TOKEN=your_bot_token
# 多个 chat_id 用英文逗号分隔，如 123456789,987654321
TG_ALERT_CHAT_IDS=your_chat_id
TG_NOTIFY_ENABLED=false
